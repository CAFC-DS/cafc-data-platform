# Hudl DVMS API credentials (https://dvms.premierleague.com/dvms/api-docs)
DVMS_USERNAME=your_username@example.com
DVMS_PASSWORD=your_password_here

# Optional overrides — defaults in config.py target the EFL Championship,
# 2025-26 season.
# DVMS_BASE_URL=https://dvms.premierleague.com
# DVMS_COMPETITION_ID=5f282b8c8cdf2d0b082cc81c
# DVMS_SEASON=2025
# DVMS_FIXTURES_PAGE_LIMIT=100

# Snowflake schema this extractor writes to. Connection/auth itself (account,
# user, RSA key, warehouse, role) comes from the shared python/_snowflake.py
# helper, which reads python/extract/impect/.env — not duplicated here.
SNOWFLAKE_SCHEMA=DVMS_RAW
